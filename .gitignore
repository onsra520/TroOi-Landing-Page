*.class


# ------------------------------------------------------------
# Python
# Used only for local tooling / simple development utilities.
# ------------------------------------------------------------

__pycache__/
*.py[cod]

.pytest_cache/
.mypy_cache/
.ruff_cache/

.venv/
venv/


